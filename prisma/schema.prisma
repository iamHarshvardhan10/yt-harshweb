generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | AUTH
 * |--------------------------------------------------------------------------
 * | Dashboard admins. Accounts are created with `npm run admin create`.
 * | Login = email + password, then a Google Authenticator (TOTP) code.
 */

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  passwordHash String?

  // TOTP secrets are AES-GCM encrypted with AUTH_SECRET
  totpSecret        String?
  totpPendingSecret String? // generated during setup, promoted once a code is verified
  totpEnabled       Boolean @default(false)
  totpLastCounter   Int? // last accepted time step — blocks code replay

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  avatarId String?
  avatar   Media?  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  // Pending invite: SHA-256 of the emailed token. Cleared once a password is set.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     Int?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  // SHA-256 of the cookie token — the raw token is never stored
  id String @id

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage     SessionStage
  expiresAt DateTime

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * |--------------------------------------------------------------------------
 * | MEDIA
 * |--------------------------------------------------------------------------
 */

model Media {
  id String @id @default(cuid())

  // Cloudinary information
  publicId     String            @unique
  secureUrl    String
  resourceType MediaResourceType

  // Original file information
  originalName String?
  format       String?

  // Image dimensions
  width  Int?
  height Int?

  // Video duration in seconds
  duration Float?

  // Cloudinary folder
  folder String?

  // Relations
  homeHeroMedia    HomeHeroMedia[]
  homeSections     HomeSection[]
  homeTestimonials HomeTestimonial[]
  aboutPages       AboutPage[]
  userAvatars      User[]          @relation("UserAvatar")
  siteLogos        SiteSettings[]  @relation("SiteLogo")
  siteFavicons     SiteSettings[]  @relation("SiteFavicon")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | HOME HERO
 * |--------------------------------------------------------------------------
 */

model HomeHero {
  id String @id @default(cuid())

  eyebrow     String?
  headline    String
  description String

  primaryButtonName String?
  primaryButtonUrl  String?

  secondaryButtonName String?
  secondaryButtonUrl  String?

  backgroundType HeroBackgroundType @default(IMAGE)

  darkOverlay    Boolean @default(false)
  overlayOpacity Int     @default(65) // 0–100, used when darkOverlay is on

  isVisible Boolean @default(true)
  autoplay  Boolean @default(true)
  loop      Boolean @default(true)

  media HomeHeroMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | HOME HERO MEDIA
 * |--------------------------------------------------------------------------
 */

model HomeHeroMedia {
  id String @id @default(cuid())

  homeHeroId String
  mediaId    String

  role HomeHeroMediaRole

  homeHero HomeHero @relation(fields: [homeHeroId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  /**
   * One hero can have only one background image
   * and only one background video.
   */
  @@unique([homeHeroId, role])
  @@index([homeHeroId])
  @@index([mediaId])
}

/**
 * |--------------------------------------------------------------------------
 * | HOME SECTIONS
 * |--------------------------------------------------------------------------
 * | Header copy for every home page section below the hero.
 * | One row per section, identified by `key`.
 * | The featured videos grid itself comes from the YouTube API — only the
 * | section header is stored here.
 */

model HomeSection {
  id String @id @default(cuid())

  key HomeSectionKey @unique

  eyebrow     String?
  title       String
  description String?

  // Optional image for the section (e.g. About centre image)
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaId])
}

/**
 * |--------------------------------------------------------------------------
 * | HOME METRICS
 * |--------------------------------------------------------------------------
 */

model HomeMetric {
  id String @id @default(cuid())

  title String
  value String

  order     Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * |--------------------------------------------------------------------------
 * | HOME ABOUT ITEMS
 * |--------------------------------------------------------------------------
 */

model HomeAboutItem {
  id String @id @default(cuid())

  title       String
  description String

  order     Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * |--------------------------------------------------------------------------
 * | HOME TESTIMONIALS
 * |--------------------------------------------------------------------------
 */

model HomeTestimonial {
  id String @id @default(cuid())

  name String
  text String

  // Static path in /public (e.g. /testimonials/x.jpg); used when no avatar is uploaded
  image String?

  avatarId String?
  avatar   Media?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  order     Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([avatarId])
}

/**
 * |--------------------------------------------------------------------------
 * | HOME FAQS
 * |--------------------------------------------------------------------------
 */

model HomeFaq {
  id String @id @default(cuid())

  question String
  answer   String

  order     Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * |--------------------------------------------------------------------------
 * | ABOUT PAGE
 * |--------------------------------------------------------------------------
 * | Singleton (id = "about"). The "About" highlights and "Metrics" blocks on
 * | this page reuse the home page content (HomeSection / HomeAboutItem /
 * | HomeMetric) — only their visibility on /about is stored here.
 */

model AboutPage {
  id String @id @default("about")

  // Hero
  heroTag     String
  heroTitle   String
  heroDesc    String
  heroImage   String // /public path, used when no image is uploaded
  heroMediaId String?
  heroMedia   Media?  @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)

  // How we work
  processTag     String
  processTitle   String
  processDesc    String
  processVisible Boolean @default(true)

  // Call to action
  ctaTag      String
  ctaTitle    String
  ctaDesc     String
  ctaBtn1     String
  ctaBtn1Link String
  ctaBtn2     String
  ctaBtn2Link String
  ctaVisible  Boolean @default(true)

  // Shared home blocks shown on /about
  showAbout   Boolean @default(true)
  showMetrics Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([heroMediaId])
}

model AboutStep {
  id          String @id @default(cuid())
  title       String
  description String

  order     Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/**
 * |--------------------------------------------------------------------------
 * | INVESTIGATIONS
 * |--------------------------------------------------------------------------
 * | One topic = one YouTube video + its research documents, one per language
 * | (English and Hindi). Documents are links (Google Drive, Docs, PDF…).
 * | Video title / duration are read from the YouTube API — only the id is stored.
 */

model Investigation {
  id String @id @default(cuid())

  slug     String @unique
  title    String
  summary  String
  category String

  status      InvestigationStatus @default(DRAFT)
  publishedAt DateTime?           @db.Date

  youtubeVideoId String?

  keyFindings String[] @default([])
  tags        String[] @default([])

  featured Boolean @default(false)
  order    Int     @default(0)

  metaTitle       String?
  metaDescription String?

  documents InvestigationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model InvestigationDocument {
  id String @id @default(cuid())

  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  language DocumentLanguage

  // Shown in the document's own language; title falls back to the investigation title
  title       String?
  description String?
  url         String

  pages       Int?
  readMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One document per language per investigation
  @@unique([investigationId, language])
}

/**
 * |--------------------------------------------------------------------------
 * | CONTENT IDEAS
 * |--------------------------------------------------------------------------
 * | Planned videos and Shorts, from first idea to upload. `uploadAt` is when
 * | it should go live on YouTube (stored in UTC, entered in IST).
 */

model ContentIdea {
  id String @id @default(cuid())

  title    String
  notes    String?
  category String?

  type     ContentIdeaType @default(VIDEO)
  stage    IdeaStage       @default(IDEA)
  priority IdeaPriority    @default(MEDIUM)

  uploadAt DateTime?

  // When the "publishing tomorrow" email went out; cleared when uploadAt changes
  reminderSentAt DateTime?

  // Set once it's live, to link the idea to the real upload
  youtubeVideoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([uploadAt])
}

/**
 * |--------------------------------------------------------------------------
 * | VIDEO SETTINGS
 * |--------------------------------------------------------------------------
 * | How each YouTube upload appears on the website, edited from
 * | /dashboard/videos. The videos themselves come from the YouTube API — a
 * | video without a row uses the defaults (visible, newest first).
 */

model VideoSetting {
  videoId String @id // YouTube video id

  isVisible  Boolean @default(true)
  showOnHome Boolean @default(false)
  featured   Boolean @default(false) // listed first, with a "Featured" badge

  displayOrder Int? // lower comes first; empty = by publish date
  category     String?

  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | NEWSLETTER
 * |--------------------------------------------------------------------------
 * | Double opt-in: website sign-ups start PENDING and become ACTIVE from the
 * | confirmation email. `token` is the secret in confirm / unsubscribe links.
 * | Campaigns are sent through Gmail (lib/mail.ts); scheduled ones by the hourly cron.
 */

model Subscriber {
  id String @id @default(cuid())

  email  String  @unique
  name   String?
  topics String[] @default([])
  source String? // where they signed up, e.g. "website"

  status SubscriberStatus @default(PENDING)
  token  String           @unique

  confirmationSentAt DateTime?
  confirmedAt        DateTime?
  unsubscribedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Campaign {
  id String @id @default(cuid())

  subject String
  preview String? // inbox preview line
  body    String // plain text; blank lines separate paragraphs, links are linked

  // Empty = every active subscriber; otherwise subscribers with any of these topics
  topics String[] @default([])

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  recipientCount Int @default(0)
  failedCount    Int @default(0)

  // Listed under "Recent issues" on /newsletter once sent
  showOnWebsite Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
}

/**
 * |--------------------------------------------------------------------------
 * | SITE SETTINGS
 * |--------------------------------------------------------------------------
 * | Singleton (id = "site") edited from /dashboard/settings.
 */

model SiteSettings {
  id String @id @default("site")

  // Website
  siteTitle       String
  siteDescription String
  siteUrl         String? // public address, used for links in emails
  allowIndexing   Boolean @default(true)

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  logoId    String?
  logo      Media?  @relation("SiteLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId String?
  favicon   Media?  @relation("SiteFavicon", fields: [faviconId], references: [id], onDelete: SetNull)

  googleAnalyticsId String?

  // Email notifications (sent to the dashboard admins)
  notifyNewSubscriber   Boolean @default(true)
  notifyUploadReminders Boolean @default(true)
  notifyNewComments     Boolean @default(false)
  notifyWeeklySummary   Boolean @default(true)

  // Bookkeeping for the hourly job
  commentsCheckedAt   DateTime?
  weeklySummarySentAt DateTime?
  lastCronRunAt       DateTime?

  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | LEGACY
 * |--------------------------------------------------------------------------
 * | HomePage is superseded by HomeHero + HomeSection (its content was copied
 * | over by the home_page_cms migration). HomeVideo will be replaced by the
 * | YouTube API. Kept so no data is dropped — safe to remove later.
 */

model HomePage {
  id           String   @id @default("home")
  heroTag      String
  heroTitle    String
  heroDesc     String
  heroBtn1     String
  heroBtn1Link String
  heroBtn2     String
  heroBtn2Link String
  heroImage    String
  videosTag    String
  videosTitle  String
  metricsTag   String
  metricsTitle String
  metricsDesc  String
  aboutTag     String
  aboutTitle   String
  aboutDesc    String
  aboutImage   String
  reviewsTag   String
  reviewsTitle String
  reviewsDesc  String
  faqTag       String
  faqTitle     String
  faqDesc      String
  contactTag   String
  contactTitle String
  contactDesc  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomeVideo {
  id          String   @id
  order       Int
  title       String
  description String
  thumbnail   String
  youtubeUrl  String
  duration    String
  publishedAt DateTime @db.Date
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum SessionStage {
  PENDING_2FA // password checked, waiting for the authenticator code
  ACTIVE
}

enum HomeSectionKey {
  FEATURED_VIDEOS
  METRICS
  ABOUT
  TESTIMONIALS
  FAQ
  CONTACT
}

enum MediaResourceType {
  IMAGE
  VIDEO
}

enum HeroBackgroundType {
  IMAGE
  VIDEO
}

enum HomeHeroMediaRole {
  BACKGROUND_IMAGE
  BACKGROUND_VIDEO
}

enum InvestigationStatus {
  DRAFT
  PUBLISHED // only published investigations appear on the website
  ARCHIVED
}

enum DocumentLanguage {
  EN
  HI
}

enum ContentIdeaType {
  VIDEO
  SHORT
}

enum IdeaStage {
  IDEA
  RESEARCH
  SCRIPT
  EDITING
  READY // done, waiting for its upload time
  UPLOADED
}

enum IdeaPriority {
  HIGH
  MEDIUM
  LOW
}

enum SubscriberStatus {
  PENDING // signed up, hasn't clicked the confirmation link
  ACTIVE
  UNSUBSCRIBED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}
